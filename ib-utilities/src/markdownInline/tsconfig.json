{
    "extends": "../../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ES2022", "DOM"],
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "types": ["vite/client", "node"]
    },
    "include": [
        "*.ts",
        "host/**/*.ts",
        "lib/**/*.ts",
        "lib/**/*.d.ts",
        "playground/**/*.ts",
        "playground/**/*.d.ts",
        "tests/**/*.ts"
    ]
}
