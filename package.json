{
    "name": "vscode-extensions",
    "version": "0.0.0",
    "private": true,
    "description": "Monorepo for IrishBruse VS Code extensions",
    "license": "MIT",
    "author": "Ethan Conneely",
    "workspaces": [
        "dev",
        "ib-*",
        "inline-markdown-editor"
    ],
    "scripts": {
        "prepare": "vp config",
        "check": "vp check",
        "lint": "vp lint",
        "format": "vp fmt --write",
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "verify": "npm run verify --workspaces --if-present",
        "package:vsix": "npm run package:vsix --workspaces --if-present",
        "install": "node dev/install-local.mjs",
        "install:all": "node dev/install-local.mjs --all",
        "release": "node dev/release.mjs"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/vscode": "^1.140.0",
        "@vitest/coverage-v8": "5.0.5",
        "@vscode/vsce": "^4.0.0",
        "typescript": "^7.0.2",
        "vite-plus": "1.4.0"
    },
    "overrides": {
        "@vitest/browser": "5.0.5",
        "@vitest/browser-preview": "5.0.5",
        "@vitest/coverage-v8": "5.0.5",
        "@vitest/ui": "5.0.5",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
        "vitest": "5.0.5"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": ">=10.0.0",
            "onFail": "download"
        }
    },
    "packageManager": "npm@11.7.0"
}
